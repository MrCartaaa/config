# Ignore everything by default
*

# Allow these specific files/directories
!.gitignore
!starship.toml
!bash_custom
!bash_custom/**
!.util
!.util/**
!nvim
!nvim/**
!tmux
!tmux/**
!hypr
!hypr/**
# Omarchy updates rewrite user shell.json; keep a git copy so we can restore.
!omarchy/
!omarchy/shell.json
!omarchy/hooks/
!omarchy/hooks/post-boot.d/
!omarchy/hooks/post-boot.d/**
omarchy/hooks/**/*.sample
!omarchy/plugins/
!omarchy/plugins/jaime.bluetooth/
!omarchy/plugins/jaime.bluetooth/**
!omarchy/plugins/jaime.systemctl/
!omarchy/plugins/jaime.systemctl/**
!systemd
!systemd/user
!systemd/user/repo-checkin.service
!systemd/user/repo-checkin.timer
!systemd/user/omarchy-theme-roller.service
!systemd/user/bucket-push.service
!systemd/user/bucket-push.timer
!systemd/user/bucket-pull.service
!systemd/user/bucket-pull.timer
!systemd/user/bucket-lifecycle.service
!systemd/user/bucket-lifecycle.timer
!systemd/user/service-failure*
!waybar
!waybar/**
!alacritty
!alacritty/**
!foot
!foot/foot.ini
!opencode
!opencode/opencode.json
!kube
!kube/config.example

# OK, now that we have all the top-dir's that we want, there are some dir's nested in them we do not want included

# Exclude cache and claude folders everywhere
**/.cache/
**/.claude/

nvim/lazy-lock.json

# Exlude the shaders dir in hypr
hypr/shaders

# Exlude private secrets
bash_custom/private_exports.conf

# Exclude Filter files for the proton-sync-drive
bash_custom/scripts/sync_drive/*.filter
# Include the example filter
!bash_custom/scripts/sync_drive/example.filter
