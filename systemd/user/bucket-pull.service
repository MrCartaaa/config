[Unit]
Description=Bucket pull (remote to local)
OnFailure=service-failure-notify@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock /tmp/bucket-sync.lock /home/jaime/.config/bash_custom/scripts/bucket/pull_bucket.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
